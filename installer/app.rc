// Windows resources: the icon (GLFW picks "GLFW_ICON" up for the window and
// taskbar; Explorer shows it for the exe) and the file's version info.
#include <winver.h>

GLFW_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CRC"
      VALUE "FileDescription", "Creative Cell"
      VALUE "FileVersion", "0.1.1"
      VALUE "InternalName", "CreativeCell"
      VALUE "OriginalFilename", "CreativeCell.exe"
      VALUE "ProductName", "Creative Cell"
      VALUE "ProductVersion", "0.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
